# Copy to .env.local and fill in from your Supabase project settings.
# Both are safe to expose to the client — the anon key only ever acts
# through RLS policies and the SECURITY DEFINER RPCs in /supabase/migrations.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Function secrets (set via `supabase secrets set`, never in this file
# or committed anywhere — see supabase/functions/telegram-auth):
#   TELEGRAM_BOT_TOKEN
#   SUPABASE_SERVICE_ROLE_KEY  (auto-provided to Edge Functions by Supabase)
